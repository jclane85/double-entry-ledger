# ================================================================
# Copy this file to .env and fill in values for your environment.
# .env is gitignored — never commit it.
# ================================================================

DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>
PORT=3001
NODE_ENV=development

# Comma-separated list of allowed CORS origins.
# Example (production): ALLOWED_ORIGINS=https://app.yourdomain.com,https://admin.yourdomain.com
# Leave unset in development — defaults to http://localhost:5173
ALLOWED_ORIGINS=
